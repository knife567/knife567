{
    "prefix": "mamba_64x64_full",
    "dataset": "wt",
    "memory_size": 0,
    "memory_per_class": 0,
    "fixed_memory": false,
    "shuffle": true,
    "init_cls": 2,
    "increment":  2,
    "model_name": "ease",
    "backbone_type": "vim_base_patch16_64_ease",
    "device": ["0"],
    "seed": [1993],

    "input_size": 64,

    "init_epochs": 5,
    "init_lr": 0.001,
    "later_epochs": 5,
    "later_lr": 0.0005,
    "batch_size": 16,
    "weight_decay": 0.01,
    "min_lr": 1e-7,
    "optimizer": "adamw",
    "scheduler": "cosine",

    "pretrained": true,
    "use_pretrained_embedding": true,

    "vpt_type": "Deep",
    "prompt_token_num": 10,
    "ffn_num": 128,
    "use_diagonal":  false,
    "recalc_sim": true,
    "alpha": 0.5,
    "use_init_ptm": true,
    "beta": 0.3,
    "use_old_data":  false,
    "use_reweight": true,

    "moni_adam": false,
    "adapter_num": -1
}